# Remote MCP (compose.yml). Copy to .env, chmod 600. Never commit the filled file.

# Clients send Authorization: Bearer <MCP_HTTP_TOKEN>. At least 32 characters: openssl rand -hex 32
MCP_HTTP_TOKEN=
# Host headers accepted on /mcp: the public name, plus 127.0.0.1:8190 for checks through an SSH tunnel
MCP_HTTP_HOSTS=mcp.example.com,127.0.0.1:8190

# Mail and calendars, one of the two:
# a) OE Copilot read gateway (/api/communication/*): reads and attachments only, Microsoft tokens never leave the agent
#OUTLOOK_MCP_SERVICE_URL=http://agent:8180
# b) OE Copilot token broker (/api/token-posta): every tool, mailbox writes included
OUTLOOK_MCP_BROKER_URL=http://agent:8180/api/token-posta
# API_KEY of the OE Copilot agent, for either
OUTLOOK_MCP_BROKER_KEY=

# Teams: TeamsRelay /mcp and its MCP_TOKEN. Empty URL = no Teams tools.
OUTLOOK_MCP_TEAMS_URL=http://webapp:8090/mcp
OUTLOOK_MCP_TEAMS_TOKEN=
